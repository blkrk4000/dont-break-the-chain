{
  "name": "dont-break-the-chain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "serve -s dist -l 3001",
    "prod": "npm run build && npm run serve",
    "dev-pm2": "pm2 start \"npm run prod\" --name \"dont-break-the-chain-dev\" --watch --ignore-watch=\"dist node_modules\"",
    "prod-pm2": "pm2 start \"npm run serve\" --name \"dont-break-the-chain\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.572.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "serve": "^14.2.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}